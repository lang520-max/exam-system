# ============================================================
#  exam-system 部署密钥模板
#
#  用法：
#    1. 复制本文件为 .env
#    2. 把下面每个值替换成你自己的强随机值
#    3. .env 已被 .gitignore 排除，不会被提交
#
#  生成强随机值（任选其一）：
#    openssl rand -hex 32
#    powershell -Command "-join (1..32 | %{ '{0:x2}' -f (Get-Random -Min 0 -Max 256) })"
# ============================================================

# MySQL root 密码（数据库容器初始化时使用；之后改这里不会同步改已有库的密码）
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_random_password

# Redis 密码（docker compose 里以 --requirepass 传给 redis-server）
REDIS_PASSWORD=CHANGE_ME_strong_random_password

# RabbitMQ 账号
RABBITMQ_USER=exam
RABBITMQ_PASSWORD=CHANGE_ME_strong_random_password

# JWT 签名密钥。
# 必须至少 256 bit（HS256 要求），即 >= 64 个十六进制字符 / 32 字节。
# 泄露它等于任何人都能伪造任意用户的 token —— 包括管理员。
JWT_SECRET=CHANGE_ME_at_least_64_hex_chars_32_bytes_256_bits

# ---- 可选：数据库 TLS 开关 ----
# app 与 mysql 在同一台机器的容器网络内时，明文可接受 -> 保持 false
# 若改用云托管数据库（RDS 等）且流量过公网 -> 必须改成 true
DB_SSL=false
# DB_SSL=false 时需要 true（MySQL 8 caching_sha2_password 首次认证）；
# DB_SSL=true 时应改成 false —— 有 TLS 就不需要公开密钥检索，开着反而放宽了中间人风险
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true

# ---- 可选：主观题 AI 评分 ----
# 默认关闭。这是【按量付费】的外部调用：每份含主观题的答卷会触发 N 次请求
# （一道主观题一次），所以不要随手打开。
#
# 打开方式：AI_ENABLED=true 并填好 AI_API_KEY。
# 若 AI_ENABLED=true 但 AI_API_KEY 为空，应用会【启动失败】——
# 这是刻意的：静默降级会表现成「主观题永远是 0 分」，比启动失败难查得多。
AI_ENABLED=false

# 阿里云百炼（DashScope）的 API Key，形如 sk-xxxxxxxx
AI_API_KEY=

# 换厂商只需改这两项，协议是 OpenAI 兼容的 /chat/completions：
#   阿里云百炼   https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   智谱 GLM     https://open.bigmodel.cn/api/paas/v4                glm-4.7
#   DeepSeek     https://api.deepseek.com/v1                         deepseek-chat
#   本地 Ollama  http://host.docker.internal:11434/v1                qwen2.5:7b
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus