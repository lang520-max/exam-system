# ---------- 构建产物 ----------
target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar

# ---------- 本地 H2 开发库（dev 档自动生成，含运行期数据，不入库） ----------
data/
*.mv.db
*.trace.db
*.lock.db

# 例外：题库原始数据必须入库 —— 它是 scripts/gen-shengben-sql.js 的输入，
# 也是「150 道专升本题目」的唯一可编辑来源。
# 注意 `data/` 会匹配任意层级下名为 data 的目录，所以要先把这个目录本身
# 重新纳入，再纳入它的内容，否则 git 根本不会往里看。
!scripts/data/
!scripts/data/**

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.factorypath

# ---------- 日志与临时文件 ----------
logs/
*.log
hs_err_pid*
replay_pid*
*.tmp

# ---------- Python（deploy/tools 与 deploy/server 下的脚本会生成）----------
__pycache__/
*.pyc

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 敏感配置（本地覆盖，不入库） ----------
src/main/resources/application-local.yml

# 部署密钥（从 .env.example 复制而来，含数据库/Redis/JWT 真实密钥）
.env
