# ============================================================================
#  exam-system 运行时环境模板（裸机部署）
#
#  这份文件是【模板】。实际文件由 deploy/server/bootstrap.sh 自动生成到
#  /etc/exam-system/exam.env（0600 root:root），密钥都是机器上随机生成的
#  —— 不要把真实密钥写进仓库里的这份模板。
# ============================================================================
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Shanghai

# ---- MySQL（bootstrap 里把 bind-address 锁在 127.0.0.1）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=exam
DB_PASSWORD=<openssl rand -hex 16>
DB_SSL=false
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true

# ---- Redis（幂等 / 登录限流 / refresh token 黑名单）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<openssl rand -hex 16>
APP_REDIS_ENABLED=true

# ---- RabbitMQ：2 GiB 机器上【刻意关闭】----
# 关掉后：不注册 @RabbitListener，交卷走同步判分 GradingEngine，业务语义一致，
# 省下 Erlang VM 的 200-300 MiB。见 docs/会话交接-项目当前状态.md §3.4。
#
#  RABBITMQ_USER / RABBITMQ_PASS 留着只是占位（将来真接上 RabbitMQ 时不用再补）。
#  实测（本机 jar + prod profile，2026-09-16）：
#    - APP_RABBITMQ_ENABLED=false 时，缺这两个变量也能正常启动，且 0 次连接尝试；
#    - 开关打开但没给账号时同样能启动，只是每几秒刷 UnknownHostException 堆栈
#      —— Spring 的属性绑定会容忍未解析占位符（@Value 才会直接失败），
#      所以「缺变量」不是保险丝，真正的开关就是下面这一行。
APP_RABBITMQ_ENABLED=false
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=unused-rabbitmq-disabled
RABBITMQ_PASS=unused-rabbitmq-disabled

# ---- JWT：缺失即启动失败（刻意不给默认值，防止用公开密钥跑生产）----
JWT_SECRET=<openssl rand -hex 32>

# ---- 主观题 AI 评分（按量付费，默认关；开启需同时给 AI_API_KEY）----
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus